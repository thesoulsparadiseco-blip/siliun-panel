# ---- Backend (Render service: siliun-backend) ----
SILIUN_ADMIN_TOKEN=change-me-to-a-long-random-string
ALLOWED_ORIGINS=https://tu-sitio.webflow.io
RESONANCE_THRESHOLD=70
DISCORD_WEBHOOK_URL=
DATA_DIR=./data

# ---- Agente personal (/agent, conectado a Claude) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AGENT_TOKEN=change-me-to-a-different-long-random-string
AGENT_DAILY_LIMIT=300

# ---- Panel UI (Render service: siliun-panel-ui) ----
API_BASE=http://localhost:8000
ADMIN_ID=admin
